# Atrazo environment variables.
# Copy to .env.local for development. In Vercel, set the same keys under
# Project → Settings → Environment Variables. Never commit real values.
# The server validates these at startup (src/server/config/env.ts) and refuses to run if one is missing.
#
# Atrazo has no third-party sign-in: a ledger's recovery code is its account, and records are
# encrypted on the phone. So there are no OAuth or email-service secrets to configure.

# ── App ───────────────────────────────────────────────────────────────
# Public base URL of the app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:6060

# ── Database: Neon Postgres (free tier) ──────────────────────────────
# Local development without Neon: DATABASE_URL=pglite (a local Postgres saved in ./.data).
# Neon console → your project → Connect. Use the POOLED string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/atrazo?sslmode=require
# Same database, DIRECT (non-pooled) string. Used only by migrations (drizzle-kit).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/atrazo?sslmode=require

# ── Operations ───────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# Optional. Phones running an app version older than this are asked to update (e.g. 1.2.0).
MIN_APP_VERSION=

# ── Scheduled jobs ───────────────────────────────────────────────────
# Authorises the daily retention job (/api/cron/purge, scheduled in vercel.json at 3 AM Manila).
# Generate one: openssl rand -base64 48   — set the same value in Vercel. Empty = job switched off.
CRON_SECRET=

# ── Development only ─────────────────────────────────────────────────
# Extra origins allowed to use the dev server, comma-separated (e.g. an HTTPS tunnel such as
# https://your-name.trycloudflare.com). This computer's Wi-Fi address is allowed automatically.
# Ignored in production.
DEV_ALLOWED_ORIGINS=
